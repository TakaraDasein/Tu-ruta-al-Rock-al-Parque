---
import { ESCENARIOS } from '../data/programacion';
import { ACCESOS, CONTORNO, MAPA_ALTO, MAPA_ANCHO, POSICION_ESCENARIO, SENDEROS } from '../data/mapa';
---
<figure class="mapa">
  <svg
    viewBox={`0 0 ${MAPA_ANCHO} ${MAPA_ALTO}`}
    role="img"
    aria-labelledby="mapa-titulo"
    data-mapa
  >
    <title id="mapa-titulo">Mapa esquemático del Parque Simón Bolívar con los escenarios</title>
    <defs>
      <marker id="flecha" viewBox="0 0 10 10" refX="7" refY="5" markerWidth="5" markerHeight="5" orient="auto-start-reverse">
        <path d="M0 0 10 5 0 10z" fill="context-stroke" />
      </marker>
    </defs>

    <path class="contorno" d={CONTORNO} />
    <ellipse class="lago" cx="330" cy="170" rx="34" ry="46" transform="rotate(-25 330 170)" />
    {SENDEROS.map((d) => <path class="sendero" d={d} />)}

    {ACCESOS.map((a) => (
      <g class="acceso" transform={`translate(${a.x} ${a.y})`}>
        <rect x="-9" y="-9" width="18" height="18" />
        <path d="M-3 -5 3 0 -3 5" />
      </g>
    ))}
    <text class="rotulo-via" x="150" y="24" transform="rotate(-11 150 24)">ACCESO CRA. 60</text>
    <text class="rotulo-via" x="10" y="160" transform="rotate(-90 10 160)">ACCESO CALLE 63</text>

    <g data-mapa-ruta></g>

    {ESCENARIOS.map((e) => {
      const p = POSICION_ESCENARIO[e.id];
      return (
        <g class:list={['escenario', { provisional: !p.confirmado }]} data-marca={e.id} transform={`translate(${p.x} ${p.y})`}>
          <circle class="escenario-halo" r="24" />
          <circle class="escenario-punto" r="15" />
          <text class="escenario-sigla" dy="1">{e.corto}</text>
          <text class="escenario-orden" data-orden y="-30"></text>
        </g>
      );
    })}

    <g class="brujula" transform="translate(60 286)">
      <path d="M0 -14 0 14 M-14 0 14 0" />
      <text y="-18">E</text>
    </g>
  </svg>
  <p class="caminata" data-caminata></p>
  <figcaption>
    Esquema basado en el mapa oficial 2025. El escenario <strong>BBC</strong> es nuevo: ubicación por confirmar.
  </figcaption>
</figure>

<style>
  .mapa {
    margin: 0 20px 16px;
  }
  svg {
    display: block;
    width: 100%;
    height: auto;
    background: #2a4a3f;
  }
  .contorno {
    fill: #3b6152;
    stroke: var(--crema);
    stroke-width: 2;
    stroke-dasharray: 2 5;
    stroke-opacity: 0.5;
  }
  .lago {
    fill: #6db2aa;
    opacity: 0.55;
  }
  .sendero {
    fill: none;
    stroke: #f08a24;
    stroke-width: 4;
    stroke-linecap: round;
    opacity: 0.45;
  }
  .acceso rect {
    fill: var(--naranja);
  }
  .acceso path {
    fill: none;
    stroke: var(--tinta);
    stroke-width: 2.5;
  }
  .rotulo-via {
    fill: var(--crema);
    opacity: 0.6;
    font: 700 10px var(--f-cond);
    letter-spacing: 0.14em;
  }
  .escenario-halo {
    fill: var(--crema);
    opacity: 0.15;
  }
  .escenario-punto {
    fill: var(--crema);
    stroke: var(--tinta);
    stroke-width: 3;
  }
  .escenario-sigla {
    fill: var(--tinta);
    font: 700 10px var(--f-cond);
    text-anchor: middle;
    dominant-baseline: central;
  }
  .escenario-orden {
    fill: var(--crema);
    font: 700 13px var(--f-cond);
    letter-spacing: 0.04em;
    text-anchor: middle;
    paint-order: stroke;
    stroke: var(--tinta);
    stroke-width: 4px;
  }
  .provisional .escenario-punto {
    stroke-dasharray: 4 3;
    fill: rgb(241 236 208 / 0.6);
  }
  .escenario.en-ruta .escenario-punto {
    fill: var(--dia);
    stroke: var(--crema);
  }
  .escenario.en-ruta .escenario-sigla {
    fill: var(--crema);
  }
  .escenario.en-ruta .escenario-halo {
    fill: var(--dia);
    opacity: 0.35;
  }
  .brujula path {
    stroke: var(--crema);
    stroke-width: 2;
    opacity: 0.6;
  }
  .brujula text {
    fill: var(--crema);
    font: 700 11px var(--f-cond);
    text-anchor: middle;
  }
  svg :global(.salto-mapa) {
    fill: none;
    stroke: var(--crema);
    stroke-width: 3;
    stroke-linecap: round;
    stroke-dasharray: 7 5;
    animation: marcha-mapa 1.2s linear infinite;
  }
  svg :global(.salto-mapa.justo) {
    stroke: #ffb15c;
  }
  svg :global(.salto-mapa.choque) {
    stroke: #ff7a6e;
  }
  svg :global(.minutos-mapa) {
    fill: var(--crema);
    font: 700 11px var(--f-cond);
    text-anchor: middle;
    paint-order: stroke;
    stroke: var(--tinta);
    stroke-width: 3px;
  }
  @keyframes marcha-mapa {
    to {
      stroke-dashoffset: -24;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    svg :global(.salto-mapa) {
      animation: none;
    }
  }
  .caminata {
    margin: 6px 0 0;
    font: 700 0.9rem/1.2 var(--f-cond);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  figcaption {
    margin-top: 6px;
    font: 500 0.8rem/1.3 var(--f-cond);
    opacity: 0.7;
  }
</style>
