---
// Umami: se activa solo si hay ID (ver .env.example). Respeta "Do Not Track" y solo
// cuenta visitas del dominio público (no localhost ni vistas previas de Vercel).
const id = import.meta.env.PUBLIC_UMAMI_ID;
const src = import.meta.env.PUBLIC_UMAMI_SRC ?? 'https://cloud.umami.is/script.js';
const dominio = Astro.site?.hostname;
---
{id && <script is:inline defer src={src} data-website-id={id} data-domains={dominio} data-do-not-track="true"></script>}
