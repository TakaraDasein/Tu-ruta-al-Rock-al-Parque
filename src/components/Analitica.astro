---
// Umami: se activa solo si hay ID (ver .env.example). Respeta "Do Not Track".
const id = import.meta.env.PUBLIC_UMAMI_ID;
const src = import.meta.env.PUBLIC_UMAMI_SRC ?? 'https://cloud.umami.is/script.js';
---
{id && <script is:inline defer src={src} data-website-id={id} data-do-not-track="true"></script>}
