---
import { CONCIERTOS, ESCENARIOS, HORA_FIN, HORA_INICIO, type Dia } from '../data/programacion';
import { aHora, aMinutos, duracion } from '../lib/tiempo';
import { imagenDe, iniciales } from '../lib/imagenes';

interface Props {
  dia: Dia;
}
const { dia } = Astro.props;

const marcas: number[] = [];
for (let m = HORA_INICIO; m <= HORA_FIN; m += 30) marcas.push(m);
---
<section
  class="parrilla"
  id={`parrilla-${dia.id}`}
  role="tabpanel"
  aria-labelledby={`tab-${dia.id}`}
  data-parrilla={dia.id}
  style={`--dia:${dia.color}; --dia-oscuro:${dia.colorOscuro}; --total:${HORA_FIN - HORA_INICIO}`}
  hidden
>
  <div class="cabeza">
    <span class="cabeza-hora" aria-hidden="true"></span>
    {ESCENARIOS.map((e) => (
      <h2 class="cabeza-esc">
        <span class="largo">{e.nombre}</span>
        <span class="corto" aria-hidden="true">{e.corto}</span>
      </h2>
    ))}
  </div>

  <div class="cuerpo">
    <ol class="horas" aria-hidden="true">
      {marcas.map((m) => <li style={`--ini:${m - HORA_INICIO}`}>{aHora(m)}</li>)}
    </ol>

    <div class="lienzo" data-lienzo>
      {ESCENARIOS.map((e) => (
        <ul class="columna" aria-label={`Escenario ${e.nombre}`}>
          {CONCIERTOS.filter((c) => c.dia === dia.id && c.escenario === e.id).map((c) => (
            <li
              class="celda"
              style={`--ini:${aMinutos(c.inicio) - HORA_INICIO}; --dur:${duracion(c.inicio, c.fin)}`}
            >
              <button
                class="nodo"
                type="button"
                data-id={c.id}
                aria-pressed="false"
                aria-label={`${c.banda}, ${c.origen}, ${c.inicio} a ${c.fin}, escenario ${e.nombre}`}
              >
                <span class="puerto puerto-in" aria-hidden="true"></span>
                <span class="nodo-nombre">
                  {c.banda}
                  {c.nota && <small>{c.nota}</small>}
                </span>
                <span class="nodo-meta">
                  <span class="chip-origen">{c.origen}</span>
                  <span class="chip-hora">
                    {c.inicio} - {c.fin}
                  </span>
                </span>
                {(() => {
                  const img = imagenDe(c.banda);
                  return img ? (
                    <span class:list={['nodo-foto', `es-${img.tipo}`]} aria-hidden="true">
                      <img src={`/${img.archivo}`} alt="" loading="lazy" decoding="async" />
                    </span>
                  ) : (
                    <span class="nodo-foto sin-imagen" aria-hidden="true">{iniciales(c.banda)}</span>
                  );
                })()}
                <span class="nodo-num" aria-hidden="true"></span>
                <span class="puerto puerto-out" aria-hidden="true"></span>
              </button>
            </li>
          ))}
        </ul>
      ))}
      <svg class="enlaces" data-enlaces aria-hidden="true"></svg>
      <div class="ahora" data-ahora hidden><span>Ahora</span></div>
    </div>
  </div>
</section>

<style>
  .parrilla {
    --ppm: 3.4px; /* píxeles por minuto */
    --col-hora: 72px;
    position: relative;
    z-index: 1;
  }

  /* ── Encabezados de escenario (fijos al hacer scroll) ── */
  .cabeza {
    position: sticky;
    top: 0;
    z-index: 5;
    display: grid;
    grid-template-columns: var(--col-hora) repeat(4, 1fr);
  }
  .cabeza-hora {
    background: var(--verde-header);
  }
  .cabeza-esc {
    margin: 0;
    padding: 16px 6px 12px;
    background: #2c4a40;
    border-left: 2px solid rgb(0 0 0 / 0.18);
    color: var(--crema);
    font: 600 clamp(0.9rem, 1.35vw, 1.45rem) / 1 var(--f-cond);
    letter-spacing: 0.1em;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    text-align: center;
    text-transform: uppercase;
  }
  .cabeza-esc:nth-child(odd) {
    background: #294238;
  }
  .corto {
    display: none;
  }

  /* ── Cuerpo: columna de horas + lienzo de nodos ── */
  .cuerpo {
    display: grid;
    grid-template-columns: var(--col-hora) 1fr;
    padding-bottom: 24px;
  }
  .horas {
    position: relative;
    margin: 0;
    padding: 0;
    list-style: none;
    background: linear-gradient(to bottom, #2c3a31, #3b3524 55%, #6a4318);
  }
  .horas li {
    position: absolute;
    top: calc(var(--ini) * var(--ppm) + 20px);
    left: 0;
    right: 0;
    translate: 0 -50%;
    color: var(--crema);
    font: 600 1.15rem/1 var(--f-cond);
    text-align: center;
  }

  .lienzo {
    position: relative;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    height: calc(var(--total) * var(--ppm) + 40px);
    padding-top: 20px;
    background-image: repeating-linear-gradient(
      to bottom,
      var(--linea) 0 1px,
      transparent 1px calc(30 * var(--ppm))
    );
    background-position: 0 20px;
    background-repeat: no-repeat repeat;
    background-size: 100% calc(var(--total) * var(--ppm) + 1px);
  }
  .columna {
    position: relative;
    margin: 0;
    padding: 0;
    list-style: none;
    border-left: 2px solid rgb(0 0 0 / 0.1);
  }
  .columna:nth-child(odd) {
    background: var(--columna-alterna);
  }

  /* ── Nodo = concierto ── */
  .celda {
    position: absolute;
    top: calc(var(--ini) * var(--ppm));
    height: calc(var(--dur) * var(--ppm));
    left: 7%;
    right: 7%;
    container-type: inline-size; /* la tipografía del nodo escala con el ancho de la columna */
  }
  .nodo {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: stretch;
    width: 100%;
    height: 100%;
    padding: 0;
    border: 0;
    background: linear-gradient(to right, var(--dia) 3px, rgb(27 42 36 / 0.14) 3px);
    color: var(--crema);
    text-align: left;
    cursor: pointer;
    transition: opacity 0.2s, transform 0.15s, background 0.2s, box-shadow 0.2s;
  }
  .nodo:hover {
    transform: translate(-2px, -2px);
    box-shadow: 4px 4px 0 rgb(27 42 36 / 0.55);
  }
  .nodo:focus-visible {
    outline: 3px solid #ffd24a;
    outline-offset: 2px;
  }
  .nodo-nombre {
    display: block;
    padding: 5px 8px 4px;
    background: var(--dia);
    font: 400 clamp(0.7rem, 7.6cqi, 1.2rem) / 1.05 var(--f-display);
    letter-spacing: 0.01em;
    text-transform: uppercase;
    overflow-wrap: break-word;
    hyphens: auto;
  }
  .nodo-nombre small {
    display: block;
    margin-top: 2px;
    font: 600 0.72em/1.1 var(--f-cond);
    letter-spacing: 0.04em;
  }
  .nodo-meta {
    display: flex;
    flex-wrap: nowrap;
    background: var(--tinta);
    font: 600 clamp(0.62rem, 5.6cqi, 0.9rem) / 1 var(--f-cond);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .nodo-meta > span {
    padding: 3px 6px;
  }
  .chip-origen {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    background: rgb(241 236 208 / 0.9);
    color: var(--tinta);
  }
  .chip-hora {
    flex: none;
    white-space: nowrap;
  }
  @container (max-width: 190px) {
    .chip-origen {
      display: none;
    }
  }

  /* Foto o logo de la banda: duotono con el color del día; a color al elegirla */
  .nodo-foto {
    position: relative;
    flex: 1;
    min-height: 0;
    overflow: hidden;
    background: var(--dia-oscuro);
  }
  .nodo-foto img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 30%;
    filter: grayscale(1) contrast(1.15) brightness(0.95);
    mix-blend-mode: luminosity;
    opacity: 0.75;
    transition: filter 0.3s, opacity 0.3s, transform 0.4s;
  }
  .nodo-foto::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, rgb(27 42 36 / 0.35), transparent 40%);
  }
  .nodo-foto.es-logo {
    background: var(--crema);
  }
  .nodo-foto.es-logo img {
    object-fit: contain;
    padding: 8px 10px;
    mix-blend-mode: multiply;
    opacity: 0.8;
  }
  .nodo-foto.sin-imagen {
    display: grid;
    place-items: center;
    background:
      repeating-linear-gradient(-45deg, rgb(0 0 0 / 0.08) 0 2px, transparent 2px 7px),
      var(--dia-oscuro);
    color: rgb(241 236 208 / 0.28);
    font: 400 clamp(1.4rem, 22cqi, 3rem) / 1 var(--f-display);
    letter-spacing: 0.06em;
  }
  .nodo:hover .nodo-foto img {
    opacity: 0.95;
    transform: scale(1.04);
  }
  .nodo[aria-pressed='true'] .nodo-foto img {
    filter: none;
    mix-blend-mode: normal;
    opacity: 1;
  }
  .nodo-num {
    position: absolute;
    right: -10px;
    bottom: 6px;
    display: none;
    place-items: center;
    width: 30px;
    height: 30px;
    border: 3px solid var(--tinta);
    border-radius: 50%;
    background: var(--crema);
    color: var(--tinta);
    font: 700 1rem/1 var(--f-cond);
  }
  .puerto {
    position: absolute;
    left: 50%;
    width: 14px;
    height: 14px;
    translate: -50% -50%;
    border: 3px solid var(--tinta);
    border-radius: 50%;
    background: var(--crema);
    opacity: 0;
    transition: opacity 0.2s;
  }
  .puerto-in {
    top: 0;
  }
  .puerto-out {
    top: 100%;
  }

  /* Elegido */
  .nodo[aria-pressed='true'] {
    z-index: 2;
    background: var(--tinta);
    box-shadow: 0 0 0 3px var(--tinta), 6px 6px 0 3px rgb(27 42 36 / 0.35);
  }
  .nodo[aria-pressed='true'] .nodo-num {
    display: grid;
  }
  .nodo[aria-pressed='true'] .puerto {
    opacity: 1;
  }
  .nodo[aria-pressed='true'].en-choque .nodo-num {
    background: var(--rojo);
    color: var(--crema);
  }

  /* Se cruza con algo de tu ruta */
  .nodo.choca {
    opacity: 0.38;
  }
  .nodo.choca .nodo-foto::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    background: repeating-linear-gradient(-45deg, rgb(27 42 36 / 0.45) 0 6px, transparent 6px 12px);
  }
  .nodo.choca:hover {
    opacity: 0.85;
  }

  .nodo.destello {
    animation: destello 0.9s ease 2;
  }
  @keyframes destello {
    50% {
      box-shadow: 0 0 0 6px #ffd24a;
    }
  }

  /* ── Conexiones SVG entre nodos ── */
  .enlaces {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    pointer-events: none;
    z-index: 3;
  }
  .enlaces :global(.tramo) {
    fill: none;
    stroke: var(--tinta);
    stroke-width: 3.5;
    stroke-linecap: round;
    stroke-dasharray: 8 7;
    animation: marcha 1.2s linear infinite;
  }
  .enlaces :global(.tramo-fondo) {
    fill: none;
    stroke: var(--crema);
    stroke-width: 8;
    stroke-linecap: round;
    opacity: 0.7;
  }
  .enlaces :global(.tramo.justo) {
    stroke: #b35400;
  }
  .enlaces :global(.tramo.choque) {
    stroke: var(--rojo);
  }
  .enlaces :global(.etiqueta rect) {
    fill: var(--tinta);
  }
  .enlaces :global(.etiqueta.justo rect) {
    fill: #b35400;
  }
  .enlaces :global(.etiqueta.choque rect) {
    fill: var(--rojo);
  }
  .enlaces :global(.etiqueta text) {
    fill: var(--crema);
    font: 700 12px var(--f-cond);
    letter-spacing: 0.06em;
  }
  @keyframes marcha {
    to {
      stroke-dashoffset: -30;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .enlaces :global(.tramo) {
      animation: none;
    }
  }

  /* Línea de "ahora" durante el festival */
  .ahora {
    position: absolute;
    left: 0;
    right: 0;
    top: calc(var(--ahora, 0) * var(--ppm) + 20px);
    z-index: 4;
    border-top: 3px solid #ffd24a;
    pointer-events: none;
  }
  .ahora span {
    position: absolute;
    left: 0;
    translate: 0 -100%;
    padding: 2px 6px;
    background: #ffd24a;
    color: var(--tinta);
    font: 700 0.75rem/1.2 var(--f-cond);
    text-transform: uppercase;
  }

  /* ── Celular: las 4 columnas caben sin scroll horizontal ── */
  @media (max-width: 720px) {
    .parrilla {
      --ppm: 3px;
      --col-hora: 42px;
    }
    .largo {
      /* oculto a la vista, pero el lector de pantalla sigue leyendo el nombre completo */
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
      white-space: nowrap;
    }
    .corto {
      display: inline;
    }
    .cabeza-esc {
      padding: 12px 2px 10px;
      letter-spacing: 0.08em;
    }
    .horas li {
      font-size: 0.8rem;
    }
    .celda {
      left: 4%;
      right: 4%;
    }
    .nodo-nombre {
      padding: 4px 5px 3px;
      font: 700 0.78rem/1.02 var(--f-cond);
      letter-spacing: 0;
      overflow-wrap: break-word;
      hyphens: auto;
    }
    .nodo-nombre small,
    .chip-origen {
      display: none;
    }
    .nodo-foto.sin-imagen {
      font-size: 1.1rem;
    }
    .nodo-meta > span {
      padding: 2px 4px;
      letter-spacing: 0.02em;
    }
    .nodo-num {
      right: -6px;
      width: 24px;
      height: 24px;
      border-width: 2px;
      font-size: 0.8rem;
    }
  }
</style>
