---
import Base from '../layouts/Base.astro';
import Cabecera from '../components/Cabecera.astro';
import SelectorDia from '../components/SelectorDia.astro';
import Parrilla from '../components/Parrilla.astro';
import PanelRuta from '../components/PanelRuta.astro';
import Salpicaduras from '../components/Salpicaduras.astro';
import ControlesMovil from '../components/ControlesMovil.astro';
import ListaDia from '../components/ListaDia.astro';
import Splash from '../components/Splash.astro';
import { todasLasImagenes } from '../lib/imagenes';
import { AUTOR } from '../data/autor';

const creditos = todasLasImagenes().sort((a, b) => a.banda.localeCompare(b.banda, 'es'));
import { DIAS } from '../data/programacion';
---
<Base
  titulo="Ruta de conciertos · Rock al Parque 2026"
  descripcion="Arma tu ruta de conciertos para Rock al Parque 2026: elige bandas, detecta choques de horario y exporta tu ruta."
>
  <div class="pagina">
    <Salpicaduras />
    <div class="contenedor">
      <Cabecera />
      <div class="disposicion">
        <main>
          <SelectorDia />
          <ControlesMovil />
          {DIAS.map((d) => <Parrilla dia={d} />)}
          {DIAS.map((d) => <ListaDia dia={d} />)}
        </main>
        <PanelRuta />
      </div>
      <footer class="pie">
        <p class="autoria">
          <span>Idea, diseño y desarrollo</span>
          <a href={AUTOR.instagram} target="_blank" rel="me noopener">
            <svg class="ig" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5" /><circle cx="12" cy="12" r="4.2" /><circle cx="17.4" cy="6.6" r="1.1" class="ig-punto" /></svg>
            {AUTOR.arroba}
          </a>
        </p>
        <p>
          Herramienta no oficial hecha por fans · Horarios tomados de la programación publicada; confírmalos en los
          canales oficiales del festival. Logo e imagen 30 años (ilustración de Tavo Garavato) © Rock al Parque / Idartes.
          Medimos el uso de forma anónima, sin cookies.
          <button type="button" class="ver-intro" data-ver-intro>Ver intro</button>
        </p>
        <details class="creditos">
          <summary>Créditos de las imágenes de las bandas</summary>
          <ul>
            {creditos.map((c) => (
              <li>
                <strong>{c.banda}</strong> — {c.tipo} ·{' '}
                <a href={c.pagina} target="_blank" rel="noopener">{c.fuente}</a>
                {c.fuente !== 'Deezer' && c.credito && <> · {c.credito}</>}
              </li>
            ))}
          </ul>
          <p>Las bandas sin imagen verificada muestran sus iniciales.</p>
        </details>
      </footer>
    </div>
  </div>
  <div class="aviso" role="status" aria-live="polite" data-aviso></div>
  <Splash />
</Base>

<script>
  import '../scripts/app';
</script>

<style>
  .pagina {
    position: relative;
    overflow-x: clip;
  }
  .contenedor {
    position: relative;
    z-index: 1;
    max-width: 1720px;
    margin: 0 auto;
    padding: 0 24px;
  }
  .disposicion {
    display: grid;
    grid-template-columns: minmax(0, 1fr) clamp(320px, 24vw, 400px);
    gap: 24px;
    align-items: start;
  }
  main {
    min-width: 0;
  }
  .pie {
    position: relative;
    z-index: 1;
    margin: 24px -24px 0;
    padding: 22px 24px 28px;
    background: var(--naranja);
    font: 600 1rem/1.4 var(--f-cond);
    letter-spacing: 0.04em;
  }
  .pie p {
    margin: 0;
  }
  .autoria {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 14px;
    align-items: center;
    margin-bottom: 14px !important;
    padding-bottom: 14px;
    border-bottom: 2px solid rgb(27 42 36 / 0.25);
  }
  .autoria span {
    font: 700 0.9rem/1 var(--f-cond);
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }
  .autoria a {
    display: inline-flex;
    gap: 8px;
    align-items: center;
    padding: 6px 12px 5px;
    background: var(--tinta);
    color: var(--crema);
    font: 400 1.15rem/1 var(--f-display);
    letter-spacing: 0.03em;
    text-decoration: none;
    transition: background 0.15s;
  }
  .autoria a:hover {
    background: var(--rojo);
  }
  .pie :global(.ig) {
    width: 1.1em;
    height: 1.1em;
    fill: none;
    stroke: currentColor;
    stroke-width: 2.2;
  }
  .pie :global(.ig-punto) {
    fill: currentColor;
    stroke: none;
  }
  .ver-intro {
    margin-left: 8px;
    padding: 2px 10px;
    border: 2px solid var(--tinta);
    background: none;
    color: var(--tinta);
    font: 700 0.85rem/1.4 var(--f-cond);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    cursor: pointer;
  }
  .creditos {
    margin-top: 12px;
    font-weight: 500;
    font-size: 0.9rem;
  }
  .creditos summary {
    cursor: pointer;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .creditos ul {
    columns: 3 260px;
    margin: 10px 0;
    padding-left: 18px;
  }
  .creditos a {
    color: inherit;
  }
  .aviso {
    position: fixed;
    left: 50%;
    bottom: 24px;
    z-index: 20;
    translate: -50% 20px;
    padding: 12px 18px;
    background: var(--tinta);
    color: var(--crema);
    font: 700 1rem/1.2 var(--f-cond);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.2s, translate 0.2s;
  }
  .aviso.visible {
    opacity: 1;
    translate: -50% 0;
  }

  @media (max-width: 960px) {
    .disposicion {
      grid-template-columns: minmax(0, 1fr);
    }
    .pie {
      padding-bottom: 90px;
    }
    .aviso {
      bottom: 80px;
    }
  }
  /* La lista solo existe en celular; ahí es la vista por defecto. */
  main :global(.lista) {
    display: none;
  }
  @media (max-width: 720px) {
    :global(body[data-vista='lista']) main :global(.lista:not([hidden])) {
      display: block;
    }
    :global(body[data-vista='lista']) main :global(.parrilla) {
      display: none;
    }
    .contenedor {
      padding: 0 12px;
    }
    .pie {
      margin: 24px -12px 0;
      padding-inline: 12px;
    }
  }
</style>
